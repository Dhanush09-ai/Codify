{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/src/pages/index.html"
    },
    {
      "source": "/contact",
      "destination": "/src/pages/contact.html"
    },
    {
      "source": "/courses",
      "destination": "/src/pages/courses.html"
    },
    {
      "source": "/activity",
      "destination": "/src/pages/account/activity.html"
    },
    {
      "source": "/profile",
      "destination": "/src/pages/account/profile.html"
    },
    {
      "source": "/settings",
      "destination": "/src/pages/account-settings.html"
    },
    {
      "source": "/certificate",
      "destination": "/src/pages/certificate.html"
    }
  ]
}