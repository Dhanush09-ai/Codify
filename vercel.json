{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/src/pages/index.html"
    },
    {
      "source": "/contact",
      "destination": "/src/pages/contact.html"
    },
    {
      "source": "/profile",
      "destination": "/src/pages/account/profile.html"
    },
    {
      "source": "/activity",
      "destination": "/src/pages/account/activity.html"
    },
{
      "source": "/courses/cpp/:lesson",
      "destination": "/src/pages/courses/course-lesson.html?course=cpp&file=chapter-1/$1.md"
    },
    {
      "source": "/courses/c/:lesson",
      "destination": "/src/pages/courses/course-lesson.html?course=c&file=chapter-1/$1.md"
    }
  ]
}